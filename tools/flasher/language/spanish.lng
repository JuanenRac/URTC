# --- Configuracion libre de herramienta (0x1A2/0x1A3) - ver EEPROM.TXT seccion 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Confirmar configuracion libre de herramienta
MSG_CONFIRM_FREE_TOOL_CONFIG=Configurar y guardar la configuracion libre de herramienta a:\n\n  {tool}\n\nEsto solo tiene efecto en una placa cuyos jumpers ID lean 11111 (los 5 instalados) - no tiene efecto en ninguna otra placa. Persiste entre ciclos de encendido hasta que se cambie explicitamente de nuevo. ¿Continuar?
LOG_FREE_TOOL_SAVED_CONFIRMED=Configuracion libre de herramienta guardada y confirmada: {tool}
LOG_FREE_TOOL_MISMATCH=Configuracion libre de herramienta establecida a {value}, pero la placa reporta {confirmed} - es posible que la escritura no se haya aplicado. Consulta de nuevo para verificar.
LOG_FREE_TOOL_NO_CONFIRMATION=Configuracion libre de herramienta: enviada, pero no llego confirmacion (firmware antiguo, o placa no conectada).
LOG_FREE_TOOL_SAVE_FAILED=Fallo al guardar la configuracion libre de herramienta: {e}
TITLE_FREE_TOOL_CONFIG=Configuracion libre de herramienta (ID pin 11111)
HELP_FREE_TOOL_CONFIG=Solo tiene efecto en una placa cuyos jumpers ID lean 11111 (los 5 instalados) - no tiene efecto en ninguna otra placa. Ver EEPROM.TXT seccion 5 para el mecanismo completo.
OPT_FREE_TOOL_NONE=0 - Ninguna seleccionada
BTN_PROGRAM=Programar

# --- Tipo de periferico + numero de serie (0x1A4/0x1A5) - ver EEPROM.TXT seccion 6 ---
TITLE_PERIPHERAL_INFO=Tipo de periferico y numero de serie
HELP_PERIPHERAL_INFO=El tipo de periferico es una constante fija del firmware (siempre URTC) y no se puede cambiar. El numero de serie es una etiqueta asignada por el usuario para distinguir varias placas en el mismo bus CAN - por defecto 0, cualquier valor de 0 a 255 es valido.
LBL_NEW_SERIAL=Nuevo numero de serie:
LOG_PERIPHERAL_NO_RESPONSE=Tipo de periferico/serie: sin respuesta (firmware antiguo, o placa no conectada).
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: desconocido (0x{value:02X})
LBL_DEVICE_SERIAL=Numero de serie: {serial}
LOG_PERIPHERAL_INFO=Info de periferico: {type}, serie={serial}
LOG_PERIPHERAL_QUERY_FAILED=Fallo al consultar tipo de periferico/serie: {e}
TITLE_INVALID_SERIAL=Numero de serie invalido
MSG_INVALID_SERIAL=Introduce un numero entero de 0 a 255.
TITLE_CONFIRM_DEVICE_SERIAL=Confirmar numero de serie del dispositivo
MSG_CONFIRM_DEVICE_SERIAL=Configurar y guardar el numero de serie de esta placa a:\n\n  {serial}\n\nEsto es un ajuste de configuracion de hardware que se hace una sola vez, no algo para cambiar casualmente - persiste entre ciclos de encendido hasta que se cambie explicitamente de nuevo. ¿Continuar?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Numero de serie guardado y confirmado: {serial}
LOG_DEVICE_SERIAL_MISMATCH=Numero de serie establecido a {value}, pero la placa reporta {confirmed} - es posible que la escritura no se haya aplicado. Consulta de nuevo para verificar.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Numero de serie: enviado, pero no llego confirmacion (firmware antiguo, o placa no conectada).
LOG_DEVICE_SERIAL_SAVE_FAILED=Fallo al guardar el numero de serie: {e}
