# --- Freie Werkzeugkonfiguration (0x1A2/0x1A3) - siehe EEPROM.TXT Abschnitt 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Freie Werkzeugkonfiguration bestaetigen
MSG_CONFIRM_FREE_TOOL_CONFIG=Die freie Werkzeugkonfiguration festlegen und speichern auf:\n\n  {tool}\n\nDies wirkt sich nur auf ein Board aus, dessen ID-Jumper 11111 lesen (alle 5 installiert) - auf jedes andere Board hat es keine Auswirkung. Bleibt uber Stromzyklen hinweg bestehen, bis sie explizit erneut geaendert wird. Fortfahren?
LOG_FREE_TOOL_SAVED_CONFIRMED=Freie Werkzeugkonfiguration gespeichert und bestaetigt: {tool}
LOG_FREE_TOOL_MISMATCH=Freie Werkzeugkonfiguration auf {value} gesetzt, aber Board meldet {confirmed} - das Schreiben hat moeglicherweise nicht funktioniert. Erneut abfragen zur Ueberpruefung.
LOG_FREE_TOOL_NO_CONFIRMATION=Freie Werkzeugkonfiguration: gesendet, aber keine Bestaetigung erhalten (aeltere Firmware, oder Board nicht verbunden).
LOG_FREE_TOOL_SAVE_FAILED=Speichern der freien Werkzeugkonfiguration fehlgeschlagen: {e}
TITLE_FREE_TOOL_CONFIG=Freie Werkzeugkonfiguration (ID-Pin 11111)
HELP_FREE_TOOL_CONFIG=Wirkt sich nur auf ein Board aus, dessen ID-Jumper 11111 lesen (alle 5 installiert) - auf jedes andere Board hat es keine Auswirkung. Siehe EEPROM.TXT Abschnitt 5 fuer den vollstaendigen Mechanismus.
OPT_FREE_TOOL_NONE=0 - Keine ausgewaehlt
BTN_PROGRAM=Programmieren

# --- Peripherietyp + Geraeteseriennummer (0x1A4/0x1A5) - siehe EEPROM.TXT Abschnitt 6 ---
TITLE_PERIPHERAL_INFO=Peripherietyp und Seriennummer
HELP_PERIPHERAL_INFO=Der Peripherietyp ist eine feste Firmware-Konstante (immer URTC) und kann nicht geaendert werden. Die Seriennummer ist eine vom Benutzer zugewiesene Kennung, um mehrere Boards am selben CAN-Bus zu unterscheiden - Standard 0, jeder Wert von 0 bis 255 ist gueltig.
LBL_NEW_SERIAL=Neue Seriennummer:
LOG_PERIPHERAL_NO_RESPONSE=Peripherietyp/Seriennummer: keine Antwort (aeltere Firmware, oder Board nicht verbunden).
LBL_PERIPHERAL_TYPE_URTC=Typ: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Typ: unbekannt (0x{value:02X})
LBL_DEVICE_SERIAL=Seriennummer: {serial}
LOG_PERIPHERAL_INFO=Peripherieinfo: {type}, Seriennummer={serial}
LOG_PERIPHERAL_QUERY_FAILED=Abfrage von Peripherietyp/Seriennummer fehlgeschlagen: {e}
TITLE_INVALID_SERIAL=Ungueltige Seriennummer
MSG_INVALID_SERIAL=Geben Sie eine ganze Zahl von 0 bis 255 ein.
TITLE_CONFIRM_DEVICE_SERIAL=Geraeteseriennummer bestaetigen
MSG_CONFIRM_DEVICE_SERIAL=Die Seriennummer dieses Boards festlegen und speichern auf:\n\n  {serial}\n\nDies ist eine einmalige Hardware-Konfigurationseinstellung, nicht etwas, das man beilaeufig aendert - sie bleibt ueber Stromzyklen hinweg bestehen, bis sie explizit erneut geaendert wird. Fortfahren?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Seriennummer gespeichert und bestaetigt: {serial}
LOG_DEVICE_SERIAL_MISMATCH=Seriennummer auf {value} gesetzt, aber Board meldet {confirmed} - das Schreiben hat moeglicherweise nicht funktioniert. Erneut abfragen zur Ueberpruefung.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Seriennummer: gesendet, aber keine Bestaetigung erhalten (aeltere Firmware, oder Board nicht verbunden).
LOG_DEVICE_SERIAL_SAVE_FAILED=Speichern der Seriennummer fehlgeschlagen: {e}
