LOG_STATUS_NAME_ONLY=  status: {name}
LOG_NO_ACK_RETRY=  no ACK for page {page} yet, waiting a bit longer (attempt {attempt}/3)...
LOG_HEARTBEAT_CONSISTENT_WITH_PAGE=  (the bootloader's own heartbeat already reports {pct}% received, consistent with this page having arrived - likely just the ACK that was lost)
LOG_PAGE_WRITTEN_ACKED=  page {page}/{total} written and acked ({elapsed:.2f}s, {kbps:.1f} KB/s)
LBL_RETRY_SINGULAR=retry
LBL_RETRY_PLURAL=retries
LOG_TRANSFER_COMPLETE=Transfer complete: {size} bytes in {elapsed:.1f}s ({kbps:.1f} KB/s average, {retries} page-ACK {retry_word})
LOG_FAILED=FAILED: {e}
LOG_UNEXPECTED_ERROR=UNEXPECTED ERROR: {e}
LOG_NO_VERIFICATION_FRAME_CHECKING=No verification frame seen within the timeout - checking whether the board is already running (the confirmation frame itself may have been lost to the reset)...
LOG_BOARD_RESPONDING_AS_APP=Board is responding as the application - the update likely succeeded even though its own confirmation frame was lost.
LOG_FLASHER_READY=URTC Flasher ready. HardwareID: 0x{hw_id:08X}, firmware version {major}.{minor}
LOG_EXPECTING_SLCAN_MODE=Expecting the adapter in SLCAN mode - see the README if your CANable shows up as anything other than a serial port.
LOG_EXPECTING_SOCKETCAN_MODE=SocketCAN mode - expecting the interface already up at 500 kbit/s (ip link set ... up type can bitrate 500000). See the README's Linux section.
LOG_DEBUG_BUNDLE_EXPORTED=Debug bundle exported to {path}
LOG_NO_SOCKETCAN_INTERFACES=No SocketCAN interfaces found. Bring one up first, e.g.:\n    sudo ip link set can0 type can bitrate 500000\n    sudo ip link set can0 up
LOG_CONNECTED_TO_PORT=Connected to {port}, CAN channel open
LOG_AT_BITRATE_SUFFIX= at {bitrate}.
LOG_NO_FIRMWARE_FOLDER=No firmware/ folder found inside tools/ (looked in: {folder}). Use Browse instead, or create that folder and put a .bin there.
