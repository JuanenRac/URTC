LBL_PERIPHERAL_TYPE_UNKNOWN=Type: unknown (0x{value:02X})
LBL_DEVICE_SERIAL=Serial: {serial}
LOG_PERIPHERAL_INFO=Peripheral info: {type}, serial={serial}
LOG_PERIPHERAL_QUERY_FAILED=Peripheral type/serial query failed: {e}
