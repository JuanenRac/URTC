# --- Configuration libre de l'outil (0x1A2/0x1A3) - voir EEPROM.TXT section 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Confirmer la configuration libre de l'outil
MSG_CONFIRM_FREE_TOOL_CONFIG=Definir et enregistrer la configuration libre de l'outil sur :\n\n  {tool}\n\nCeci ne prend effet que sur une carte dont les cavaliers ID lisent 11111 (les 5 installes) - cela n'a aucun effet sur toute autre carte. Persiste a travers les cycles d'alimentation jusqu'a ce qu'il soit explicitement change a nouveau. Continuer ?
LOG_FREE_TOOL_SAVED_CONFIRMED=Configuration libre de l'outil enregistree et confirmee : {tool}
LOG_FREE_TOOL_MISMATCH=Configuration libre de l'outil definie sur {value}, mais la carte indique {confirmed} - l'ecriture n'a peut-etre pas ete appliquee. Interrogez a nouveau pour verifier.
LOG_FREE_TOOL_NO_CONFIRMATION=Configuration libre de l'outil : envoyee, mais aucune confirmation n'est revenue (firmware ancien, ou carte non connectee).
LOG_FREE_TOOL_SAVE_FAILED=Echec de l'enregistrement de la configuration libre de l'outil : {e}
TITLE_FREE_TOOL_CONFIG=Configuration libre de l'outil (broche ID 11111)
HELP_FREE_TOOL_CONFIG=Ne prend effet que sur une carte dont les cavaliers ID lisent 11111 (les 5 installes) - aucun effet sur toute autre carte. Voir EEPROM.TXT section 5 pour le mecanisme complet.
OPT_FREE_TOOL_NONE=0 - Aucun selectionne
BTN_PROGRAM=Programmer

# --- Type de peripherique + numero de serie (0x1A4/0x1A5) - voir EEPROM.TXT section 6 ---
TITLE_PERIPHERAL_INFO=Type de peripherique et numero de serie
HELP_PERIPHERAL_INFO=Le type de peripherique est une constante fixe du firmware (toujours URTC) et ne peut pas etre modifie. Le numero de serie est une etiquette attribuee par l'utilisateur pour distinguer plusieurs cartes sur le meme bus CAN - par defaut 0, toute valeur de 0 a 255 est valide.
LBL_NEW_SERIAL=Nouveau numero de serie :
LOG_PERIPHERAL_NO_RESPONSE=Type de peripherique/serie : aucune reponse (firmware ancien, ou carte non connectee).
LBL_PERIPHERAL_TYPE_URTC=Type : URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Type : inconnu (0x{value:02X})
LBL_DEVICE_SERIAL=Numero de serie : {serial}
LOG_PERIPHERAL_INFO=Info peripherique : {type}, serie={serial}
LOG_PERIPHERAL_QUERY_FAILED=Echec de l'interrogation du type de peripherique/serie : {e}
TITLE_INVALID_SERIAL=Numero de serie invalide
MSG_INVALID_SERIAL=Entrez un nombre entier de 0 a 255.
TITLE_CONFIRM_DEVICE_SERIAL=Confirmer le numero de serie de l'appareil
MSG_CONFIRM_DEVICE_SERIAL=Definir et enregistrer le numero de serie de cette carte sur :\n\n  {serial}\n\nCeci est un reglage de configuration materielle ponctuel, pas quelque chose a changer a la legere - il persiste a travers les cycles d'alimentation jusqu'a ce qu'il soit explicitement change a nouveau. Continuer ?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Numero de serie enregistre et confirme : {serial}
LOG_DEVICE_SERIAL_MISMATCH=Numero de serie defini sur {value}, mais la carte indique {confirmed} - l'ecriture n'a peut-etre pas ete appliquee. Interrogez a nouveau pour verifier.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Numero de serie : envoye, mais aucune confirmation n'est revenue (firmware ancien, ou carte non connectee).
LOG_DEVICE_SERIAL_SAVE_FAILED=Echec de l'enregistrement du numero de serie : {e}
