TAB_EXPANSION_BOARD=Scheda di espansione
LBL_EXPANSION_BOARD_TYPE=Tipo di scheda di espansione (vedi EXPANSION.TXT):
BTN_EXPORT_ASC=Esporta .asc...
BTN_EXPORT_TRC=Esporta .trc...
BTN_EXPORT_DEBUG_BUNDLE=Esporta pacchetto di debug...
LBL_EXTRUDER_DIRECTION=Direzione estrusore:
HELP_EXTRUDER_MOTION_SHARED_FRAME=Il movimento dell'estrusore condivide questo stesso frame con il setpoint dell'ugello (0x170) ma non e esso stesso protetto da watchdog - solo la temperatura lo e.
LBL_EXTRUDER_STEPS=Passi estrusore:
TAB_FRAM=F-RAM
TAB_GLOBAL_CONTROLS=Controlli globali
LBL_HEATER_ACTIVE_250MS=Riscaldatore attivo (watchdog 250ms)
LBL_HOTEND_FAN_RPM=RPM ventola hotend:
LBL_HOTEND_FAN_POWER=Potenza ventola hotend (0-255):
LBL_HOTEND_TEMPERATURE=Temperatura hotend:
LBL_ID_PINS=Pin ID:
LBL_IMPACTS_DETECTED_SESSION=Impatti rilevati in questa sessione:
HELP_AOI_RING_IGNORED=In modalita Ispezione AOI, l'accensione/spegnimento dell'anello qui viene ignorato - usa il controllo di modalita anello proprio di quello strumento (0x150 copre accensione/spegnimento/strobo li). Il colore si applica comunque.
LBL_INTERLOCK_ARMED=Interlock armato (necessario perche qualsiasi potenza > 0 abbia effetto)
HELP_INTERLOCK_MUST_BE_ARMED=L'interlock deve essere armato esplicitamente qui sotto - questo e un vero laser.
LBL_LAST_IMPACT=Ultimo impatto:
LBL_LAYER_FAN_RPM=RPM ventola di strato:
LBL_LAYER_FAN_POWER=Potenza ventola di strato (0-255):
LBL_LIVE_TEMPERATURE=Temperatura in tempo reale:
TITLE_LOG=Registro
BTN_MOVE_EXTRUDER_ONCE=Muovi estrusore una volta
BTN_MOVE=Muovi
HELP_NO_WATCHDOG_STALL_DETECTOR=Nessun watchdog di comunicazione su questa ventola - e protetta invece da un rilevatore di blocco (0 RPM per 3s dall'avvio = Errore Critico), poiche perdere questa ventola conta anche se il master tace brevemente.
STATUS_NO_RESPONSE_CHECK_WIRING=Nessuna risposta - controlla cablaggio/alimentazione/velocita bus
STATUS_NO_RESPONSE_ANY_BITRATE=Nessuna risposta a nessuna velocita bus standard
STATUS_NO_RESPONSE_0X110=Nessuna risposta a 0x110 - il firmware di questa scheda e abbastanza recente da supportarlo?
HELP_NO_WATCHDOG_HOLDS_VALUE=Nessun watchdog su questo comando - rimane finche non viene inviato un nuovo valore, velocita 0 attiva il freno.
STATUS_NOT_CONNECTED=Non connesso
LBL_NOZZLE_SETPOINT=Setpoint ugello (\u00b0C, 0-300):
LBL_OLED_MODE=Modalita OLED:
HELP_ONE_SHOT_NO_TELEMETRY=Comando singolo, nessuna telemetria da questo strumento - il firmware abilita il driver alla ricezione di questo frame e toglie potenza al termine del movimento.
BTN_OPEN_BUS_MONITOR=Apri monitor bus grezzo...
LBL_PART_DETECTED_LM393=Pezzo rilevato (LM393):
BTN_PAUSE=Pausa
LBL_PERSISTENCE_FRAM=F-RAM di persistenza (FM24CL64B, condivide I2C2 con l'OLED):
LBL_POWER_0_255=Potenza (0-255):
BTN_QUERY_DIAG0=Interroga DIAG0
BTN_QUERY_STATE=Interroga stato
BTN_QUERY=Interroga
HELP_READONLY_SET_VIA_FLASHER=Sola lettura qui - impostato tramite la sezione CAN OTA di URTC Flasher, poiche e un passaggio di configurazione hardware una tantum fatto insieme a un aggiornamento firmware, non qualcosa da cambiare da questo strumento.
BTN_REFRESH=Aggiorna
LBL_REPEAT_EVERY=Ripeti ogni
LBL_RESPONSE=Risposta:
LBL_RING_LED_RGB=LED anello (R/G/B):
HELP_RING_COLOR_FROM_GLOBAL=Il colore dell'anello proviene dal pannello Controlli globali sopra (0x100) - questo controlla solo la temporizzazione accensione/spegnimento/strobo, non il colore stesso.
LBL_RING_MODE=Modalita anello:
CHK_RING_ON=Anello acceso
BTN_RUN_SELF_TEST=Esegui autotest...
LBL_SPI_BYTES_TO_SEND=Byte SPI da inviare (hex, separati da spazio):
TITLE_SCAN_PROBE_TELEMETRY=Sonda di scansione - solo telemetria eventi (0x095)
BTN_SEND_ONCE=Invia una volta
BTN_SEND=Invia
HELP_SENDS_RAW_FRAME=Invia un frame grezzo - utile per un comando che non ha ancora un proprio controllo dedicato qui, o per testare qualcosa non (ancora) documentato in CANBUS.TXT. Nessuna validazione oltre al range dell'ID e DLC\u22648 - cio che viene inviato e esattamente cio che va sul bus.
HELP_SCAN_PROBE_INTERRUPT=Inviato direttamente dall'interrupt di tocco al livello piu basso (massima priorita) ID CAN su tutto il bus, bypassando ogni scheduler - per progetto, questo dovrebbe arrivare praticamente all'istante ad ogni contatto.
RADIO_SERIAL_SLCAN=Seriale / SLCAN
LBL_SETPOINT_TEMPERATURE=Setpoint temperatura (\u00b0C, 0-450):
HELP_SHOWS_EVERY_FRAME=Mostra ogni frame visto, qualsiasi ID - indipendente dal pannello strumento attivo.
RADIO_SOCKETCAN_NATIVE=SocketCAN (nativo)
LBL_SPEED_0_255=Velocita (0-255):
LBL_STATUS_LED_OVERRIDE=Override LED di stato (R/G/B):
LBL_STEPS=Passi:
LBL_STROBE_PERIOD=Periodo strobo:
LBL_TOOL_NUMBER=Utensile #:
TAB_TOOL_CONTROLS=Controlli utensile
LBL_TRANSPORT=Trasporto:
STATUS_TRYING_EACH_BITRATE=Prova di ogni velocita bus...
HELP_UP_TO_7_BYTES_SPI=Fino a 7 byte per trasferimento (CS mantenuto basso per l'intera operazione) - corrisponde a cio che un singolo frame 0x180 puo trasportare (1 byte di lunghezza + fino a 7 byte dati).
TITLE_VACUUM_TELEMETRY=Presa a vuoto - solo telemetria (0x145)
LBL_MS_UNIT=ms
LBL_CAN_INTERFACE=Interfaccia CAN:
HELP_SOCKETCAN_BITRATE_OS_LEVEL=La velocita bus di SocketCAN e impostata a livello di sistema operativo (ip link), non qui
