LBL_CAN_ID_HEX=ID CAN (hex):
LBL_COM_PORT=Porta COM:
BTN_CLEAR=Pulisci
LBL_CONNECT_AND_DETECT_PROMPT=Connetti e rileva l'utensile attivo per vedere qui i suoi controlli.
TAB_CONNECT_TITLE=Connetti all'adattatore USB-CAN
BTN_CONNECT=Connetti
TAB_CUSTOM_FRAME=Frame CAN personalizzato
LBL_DATA_BYTES_HEX=Byte dati (hex, separati da spazio):
