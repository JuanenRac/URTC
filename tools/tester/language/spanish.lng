# URTC Tester - archivo de idioma Español
# CLAVE=Valor, uno por linea. Las lineas que empiezan por # y las lineas
# en blanco se ignoran. Un \n literal dentro de un valor se convierte en
# un salto de linea real.

STATUS_CONNECT_TO_CHECK=(conecta para comprobar)
STATUS_CONNECT_TO_DETECT=(conecta para detectar)
STATUS_NO_RESPONSE_SHORT=(sin respuesta)
LBL_ACTIVE_1000MS_WATCHDOG=Activo (vigilancia de 1000ms)
LBL_ACTIVE_250MS_WATCHDOG=Activo (reenvio automatico para satisfacer la vigilancia de 250ms)
LBL_ACTIVE_TOOL=Herramienta activa:
LBL_ACTUAL_RPM=RPM real:
LBL_ANALOG_READING=Lectura analogica (ADC de 12 bits):
BTN_AUTO_DETECT=Autodetectar
LBL_BITRATE=Velocidad de bus:
LBL_BOARD_STATE=Estado de la placa:
LBL_CAN_ID_HEX=ID CAN (hex):
LBL_COM_PORT=Puerto COM:
BTN_CLEAR=Limpiar
LBL_CONNECT_AND_DETECT_PROMPT=Conecta y detecta la herramienta activa para ver sus controles aqui.
TAB_CONNECT_TITLE=Conectar al adaptador USB-CAN
BTN_CONNECT=Conectar
TAB_CUSTOM_FRAME=Trama CAN personalizada
LBL_DATA_BYTES_HEX=Bytes de datos (hex, separados por espacio):
BTN_DETECT=Detectar
STATUS_DETECTING=Detectando...
LBL_DIRECTION=Direccion:
BTN_DISCONNECT=Desconectar
LBL_ENDSTOP_LIMIT_SWITCH=Final de carrera:
BTN_ERASE_FRAM=Borrar F-RAM...
TAB_EXPANSION_BOARD=Placa de expansion
LBL_EXPANSION_BOARD_TYPE=Tipo de placa de expansion (ver EXPANSION.TXT):
BTN_EXPORT_ASC=Exportar .asc...
BTN_EXPORT_TRC=Exportar .trc...
BTN_EXPORT_DEBUG_BUNDLE=Exportar paquete de depuracion...
LBL_EXTRUDER_DIRECTION=Direccion del extrusor:
HELP_EXTRUDER_MOTION_SHARED_FRAME=El movimiento del extrusor comparte esta misma trama con la consigna de la boquilla (0x170), pero no esta vigilado por watchdog en si mismo - solo la temperatura lo esta.
LBL_EXTRUDER_STEPS=Pasos del extrusor:
TAB_FRAM=F-RAM
TAB_GLOBAL_CONTROLS=Controles globales
LBL_HEATER_ACTIVE_250MS=Calentador activo (vigilancia de 250ms)
LBL_HOTEND_FAN_RPM=RPM del ventilador del hotend:
LBL_HOTEND_FAN_POWER=Potencia del ventilador del hotend (0-255):
LBL_HOTEND_TEMPERATURE=Temperatura del hotend:
LBL_ID_PINS=Pines de ID:
LBL_IMPACTS_DETECTED_SESSION=Impactos detectados esta sesion:
HELP_AOI_RING_IGNORED=En modo Inspeccion AOI, el encendido/apagado del anillo aqui se ignora - usa el propio control de modo de anillo de esa herramienta (0x150 cubre encendido/apagado/estrobo ahi). El color se sigue aplicando.
LBL_INTERLOCK_ARMED=Enclavamiento armado (necesario para que cualquier potencia > 0 tenga efecto)
HELP_INTERLOCK_MUST_BE_ARMED=El enclavamiento debe armarse explicitamente abajo - esto es un laser real.
LBL_LAST_IMPACT=Ultimo impacto:
LBL_LAYER_FAN_RPM=RPM del ventilador de capa:
LBL_LAYER_FAN_POWER=Potencia del ventilador de capa (0-255):
LBL_LIVE_TEMPERATURE=Temperatura en vivo:
TITLE_LOG=Registro
BTN_MOVE_EXTRUDER_ONCE=Mover extrusor una vez
BTN_MOVE=Mover
HELP_NO_WATCHDOG_STALL_DETECTOR=Este ventilador no tiene vigilancia de comunicacion - esta protegido por un detector de bloqueo en su lugar (0 RPM durante 3s tras arrancar = Error Critico), ya que perder este ventilador importa incluso si el maestro se queda callado brevemente.
STATUS_NO_RESPONSE_CHECK_WIRING=Sin respuesta - revisa cableado/alimentacion/velocidad de bus
STATUS_NO_RESPONSE_ANY_BITRATE=Sin respuesta a ninguna velocidad de bus estandar
STATUS_NO_RESPONSE_0X110=Sin respuesta a 0x110 - ¿el firmware de esta placa es lo bastante reciente como para soportarlo?
HELP_NO_WATCHDOG_HOLDS_VALUE=Este comando no tiene vigilancia - se mantiene hasta que se envia un nuevo valor, 0 de velocidad activa el freno.
STATUS_NOT_CONNECTED=No conectado
LBL_NOZZLE_SETPOINT=Consigna de la boquilla (\u00b0C, 0-300):
LBL_OLED_MODE=Modo OLED:
HELP_ONE_SHOT_NO_TELEMETRY=Comando de un solo disparo, sin telemetria de esta herramienta - el firmware activa el driver al recibir esta trama y corta la potencia cuando termina el movimiento.
BTN_OPEN_BUS_MONITOR=Abrir monitor de bus en bruto...
LBL_PART_DETECTED_LM393=Pieza detectada (LM393):
BTN_PAUSE=Pausar
LBL_PERSISTENCE_FRAM=F-RAM de persistencia (FM24CL64B, comparte I2C2 con el OLED):
LBL_POWER_0_255=Potencia (0-255):
BTN_QUERY_DIAG0=Consultar DIAG0
BTN_QUERY_STATE=Consultar estado
BTN_QUERY=Consultar
HELP_READONLY_SET_VIA_FLASHER=Solo lectura aqui - se configura desde la seccion CAN OTA del URTC Flasher, ya que es un paso de configuracion de hardware que se hace una sola vez junto con una actualizacion de firmware, no algo que se cambie desde esta herramienta.
BTN_REFRESH=Actualizar
LBL_REPEAT_EVERY=Repetir cada
LBL_RESPONSE=Respuesta:
LBL_RING_LED_RGB=LED de anillo (R/G/B):
HELP_RING_COLOR_FROM_GLOBAL=El color del anillo viene del panel de Controles globales de arriba (0x100) - esto solo controla el temporizado de encendido/apagado/estrobo, no el color en si.
LBL_RING_MODE=Modo de anillo:
CHK_RING_ON=Anillo encendido
BTN_RUN_SELF_TEST=Ejecutar autoprueba...
LBL_SPI_BYTES_TO_SEND=Bytes SPI a enviar (hex, separados por espacio):
TITLE_SCAN_PROBE_TELEMETRY=Sonda de escaneo - solo telemetria de eventos (0x095)
BTN_SEND_ONCE=Enviar una vez
BTN_SEND=Enviar
HELP_SENDS_RAW_FRAME=Envia una trama en bruto - util para un comando que aun no tiene su propio control dedicado aqui, o para probar algo no documentado (o no documentado todavia) en CANBUS.TXT. Sin validacion mas alla del rango de ID y DLC\u22648 - lo que se envia es exactamente lo que sale al bus.
HELP_SCAN_PROBE_INTERRUPT=Enviado directamente desde la interrupcion de contacto en el nivel mas bajo (mayor prioridad) de ID CAN de todo el bus, saltandose cualquier planificador - por diseño, esto deberia llegar practicamente al instante en cada contacto.
RADIO_SERIAL_SLCAN=Serie / SLCAN
LBL_SETPOINT_TEMPERATURE=Consigna de temperatura (\u00b0C, 0-450):
HELP_SHOWS_EVERY_FRAME=Muestra cada trama vista, cualquier ID - independiente del panel de herramienta activo.
RADIO_SOCKETCAN_NATIVE=SocketCAN (nativo)
LBL_SPEED_0_255=Velocidad (0-255):
LBL_STATUS_LED_OVERRIDE=Anulacion del LED de estado (R/G/B):
LBL_STEPS=Pasos:
LBL_STROBE_PERIOD=Periodo de estrobo:
LBL_TOOL_NUMBER=Herramienta #:
TAB_TOOL_CONTROLS=Controles de herramienta
LBL_TRANSPORT=Transporte:
STATUS_TRYING_EACH_BITRATE=Probando cada velocidad de bus...
HELP_UP_TO_7_BYTES_SPI=Hasta 7 bytes por transferencia (CS mantenido bajo durante toda la operacion) - coincide con lo que puede llevar una sola trama 0x180 (1 byte de longitud + hasta 7 bytes de datos).
TITLE_VACUUM_TELEMETRY=Ventosa de vacio - solo telemetria (0x145)
LBL_MS_UNIT=ms
LBL_CAN_INTERFACE=Interfaz CAN:
HELP_SOCKETCAN_BITRATE_OS_LEVEL=La velocidad de bus de SocketCAN se configura a nivel del sistema operativo (ip link), no aqui
COL_TIME=Hora
COL_ID=ID
COL_DLC=DLC
COL_DATA_HEX=Datos (hex)
COL_DT_MS=Δt (ms)
TITLE_RESTART_NEEDED=Reinicio necesario
MSG_RESTART_NEEDED=Reinicia URTC Tester para que el nuevo idioma surta efecto.
TITLE_COULDNT_SAVE=No se pudo guardar
MSG_LANGUAGE_NOT_SAVED=La preferencia de idioma no se guardo - comprueba que {path} tenga permisos de escritura.
TITLE_NOT_CONNECTED=No conectado
MSG_CONNECT_FIRST=Conecta al adaptador primero.
TITLE_BAD_INPUT=Entrada incorrecta
TITLE_EXPORT_FAILED=Fallo al exportar
TITLE_NOTHING_SELECTED=Nada seleccionado
MSG_SELECT_PORT_FIRST=Selecciona un puerto/interfaz primero.
TITLE_CONNECTION_FAILED=Fallo de conexion
TITLE_ALREADY_CONNECTED=Ya conectado
MSG_DISCONNECT_FIRST_AUTODETECT=Desconecta primero, luego autodetecta antes de reconectar.
MSG_SELECT_COM_PORT_FIRST=Selecciona un puerto COM primero.
TITLE_NOT_DETECTED=No detectado
MSG_RUN_DETECT_FIRST=Ejecuta Detectar primero, para saber que herramienta probar.
TITLE_NOTHING_TO_EXPORT=Nada que exportar
MSG_TABLE_IS_EMPTY=La tabla esta vacia.
TITLE_NO_CONFIRMATION=Sin confirmacion
MSG_ERASE_NO_RESPONSE=Comando de borrado enviado, pero no llego ninguna respuesta que lo confirme.
TITLE_ERASED=Borrado
MSG_FRAM_ERASED_CONFIRMED=F-RAM borrada y confirmada por la placa.
TITLE_DEBUG_BUNDLE_SAVED=Paquete de depuracion guardado
MSG_SAVED_TO=Guardado en:\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Fallo de conexion - permiso denegado
MSG_PERMISSION_DENIED_HELP={msg}\n\nEn Linux, los dispositivos serie normalmente necesitan que tu usuario este en el grupo 'dialout':\n\n    sudo usermod -a -G dialout $USER\n\nLuego cierra sesion y vuelve a entrar (los grupos se leen al iniciar sesion) e intentalo de nuevo.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial no esta instalado
MSG_PYSERIAL_NEEDED_AUTODETECT=La autodeteccion necesita pyserial para conexiones serie/SLCAN.\n\nInstalalo con: pip install pyserial
TITLE_RUN_SELF_TEST_Q=¿Ejecutar autoprueba?
MSG_SELF_TEST_CONFIRM=Esto envia un pequeño numero de comandos seguros en reposo (consigna/velocidad/potencia todo a 0) para verificar que la placa responde como se espera para la herramienta detectada - nada aqui calienta, dispara o gira nada a potencia real. ¿Continuar?
TITLE_ERASE_FRAM_Q=¿Borrar F-RAM?
MSG_ERASE_FRAM_CONFIRM=Esto borra permanentemente el estado de parametros guardado en la F-RAM de persistencia de la placa. Esto no se puede deshacer. ¿Continuar?
TITLE_PLAIN_STEPPER_MOTION={tool} - movimiento simple de motor paso a paso (0x120)
OPT_STANDARD=Estandar
OPT_NIGHT=Noche
OPT_STANDBY=Espera
OPT_FORWARD=Adelante
OPT_REVERSE=Reversa
OPT_CLOCKWISE=Horario
OPT_COUNTER_CLOCKWISE=Antihorario
OPT_OFF=Apagado
OPT_SYNCHRONOUS_STROBE=Estrobo sincronizado
OPT_FIXED_CONTINUOUS=Fijo continuo
OPT_RETRACT=Retraer
WARN_NO_CARRIER=AVISO: {interface} reporta sin portadora - esto es lo que el kernel muestra durante una condicion de bus-off de CAN (demasiados errores de transmision) o un enlace igualmente caido. Si el adaptador esta encendido y cableado a un bus activo, prueba: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=error de lectura del bus: {e}
LOG_HANDLER_ERROR=error de manejador para 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=error de callback de sniffer: {e}
LOG_TESTER_READY=URTC Tester listo. HardwareID esperado: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Se espera el adaptador en modo SLCAN - consulta el README si tu CANable aparece como algo distinto a un puerto serie.
LOG_EXPECTING_SOCKETCAN_MODE=Modo SocketCAN - se espera que la interfaz ya este activa a 500 kbit/s (ip link set ... up type can bitrate 500000). Consulta la seccion de Linux del README.
LOG_CONNECTED_TO_PORT=Conectado a {port}, canal CAN abierto
LOG_AT_BITRATE_SUFFIX= a {bitrate}.
LOG_DISCONNECTED=Desconectado.
LOG_AUTODETECT_TRYING=Autodeteccion: probando {label}...
LOG_AUTODETECT_RESPONDED=Autodeteccion: la placa respondio a {label}.
LOG_AUTODETECT_NO_RESPONSE=Autodeteccion: sin respuesta a ninguna velocidad de bus estandar - revisa cableado/alimentacion, o la placa podria estar usando una velocidad no estandar que esto no puede probar.
LOG_QUERYING_ACTIVE_TOOL=Consultando herramienta activa (0x110)...
LOG_QUERYING_VERSION=Consultando version (0x7F8)...
LOG_DETECT_FAILED=Deteccion fallida: {e} - la conexion pudo haberse cerrado mientras esto estaba en curso.
LOG_DETECTION_FAILED=Deteccion fallida: sin respuesta a ninguna de las dos consultas.
LOG_ACTIVE_TOOL_STATE=Herramienta activa: {name} (ID {tool_id}). Estado: {state}.
LOG_NO_RESPONSE_0X110_HELP=Sin respuesta a la consulta de herramienta activa (0x110/0x111) - esto necesita STM32F303CC.C compilado con ese soporte; el firmware antiguo no lo respondera.
LOG_VERSION_INFO=Version: {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=No se pudo enviar el comando de apagado 0x{cmd_id:03X} al cambiar de la herramienta {tool_id}: {e}
LOG_OFF_COMMAND_FAILED=No se pudo enviar el comando de apagado al cambiar de la herramienta {tool_id}: {e}
LOG_SENT_GLOBAL_STATUS=Enviado 0x100: RGB de estado=({r1},{g1},{b1}), noche={night}, RGB de anillo=({r2},{g2},{b2}), anillo_encendido={ring_on}
LOG_EXPORTED_FRAMES=Exportadas {n} tramas a {path}
LOG_QUERIED_0X182_NO_RESPONSE=Consultado 0x182 - sin respuesta 0x183.
LOG_EXP_TMC_DIAG0_LEVEL=Nivel TMC_DIAG0: {level}
LBL_EMPTY_PARENS=(vacio)
LOG_SENT_CUSTOM_FRAME=Trama personalizada enviada: ID=0x{can_id:03X}, datos={data}
LOG_REPEATING_CUSTOM_FRAME=Repitiendo trama personalizada cada {interval}ms: ID=0x{can_id:03X}, datos={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Trama periodica personalizada: saltando ciclos hasta que el campo sea valido de nuevo ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Trama periodica personalizada: el campo vuelve a ser valido, reanudando envios.
MSG_ENTER_HEX_BYTES_EXAMPLE=Introduce bytes hexadecimales separados por espacio, ej. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Introduce entre 1 y 7 bytes.
LBL_SPI_NO_RESPONSE=(sin respuesta - la placa no ejecuta esta version de firmware, o no esta conectada)
LOG_SENT_0X180_NO_RESPONSE=Enviado 0x180 ({tx}) - sin respuesta 0x181.
LBL_SPI_MALFORMED=(mal formado: declaro {n} bytes, pero solo llegaron {actual})
LOG_SENT_0X180_MALFORMED=Enviado 0x180 ({tx}) - la respuesta 0x181 declaro {n} bytes pero solo llegaron {actual}: {rx}
LOG_SENT_0X180_RECEIVED=Enviado 0x180 ({tx}), recibido de vuelta: {rx}
LOG_QUERIED_0X1A1_NO_RESPONSE=Consultado 0x1A1 - sin respuesta valida.
LOG_EXPANSION_BOARD_TYPE=Tipo de placa de expansion: {label}
LOG_QUERIED_0X190_NO_RESPONSE=Consultado 0x190 - sin respuesta 0x191.
LOG_FRAM_STATE_NOTHING_SAVED=Estado de F-RAM: nada valido guardado.
LOG_FRAM_STATE_FULL=Estado de F-RAM: herramienta={tool}, temp={temp}, velocidad/potencia={speed}, direccion/enclavamiento={dir_or_interlock}, ventilador={fan}, hubo_error={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Borrado de F-RAM enviado (0x192) - no llego respuesta de confirmacion.
LOG_FRAM_ERASED_CONFIRMED=F-RAM borrada y confirmada.
LOG_KEEPALIVE_STOPPED=Vigilancia periodica '{name}' detenida: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Soldador: consigna {temp}°C, enviando cada 150ms (la vigilancia del firmware es de 250ms).
LOG_SOLDER_TURNED_OFF=Soldador: apagado (consigna 0 enviada una vez).
LOG_TOOL_MOVE={tool}: mover {direction}, {n} pasos.
LOG_AOI_MODE_PERIOD=AOI: modo={mode}, periodo={period}
LBL_ARMED=armado
LBL_SAFE=seguro
LOG_LASER_POWER_INTERLOCK=Laser: potencia {power}, enclavamiento {interlock}, enviando cada 150ms (la vigilancia del firmware es de 250ms).
LOG_LASER_STOPPED=Laser: detenido (potencia 0, enclavamiento seguro enviado una vez).
LOG_SCAN_PROBE_IMPACT=Sonda de escaneo: impacto detectado a las {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=Boquilla de impresora 3D: consigna {temp}°C, enviando cada 150ms (la vigilancia del firmware es de 250ms, el movimiento del extrusor no tiene vigilancia).
LOG_3DP_NOZZLE_TURNED_OFF=Boquilla de impresora 3D: apagada (consigna 0 enviada una vez).
LOG_LAYER_FAN_ACTIVE=Ventilador de capa: potencia {power}, enviando cada 400ms (la vigilancia del firmware es de 1000ms).
LOG_LAYER_FAN_STOPPED=Ventilador de capa: detenido (potencia 0 enviada una vez).
LOG_DEBUG_BUNDLE_EXPORTED=Paquete de depuracion exportado a {path}

