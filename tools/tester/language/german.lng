TAB_CUSTOM_FRAME=Benutzerdefinierter CAN-Frame
LBL_DATA_BYTES_HEX=Datenbytes (hex, durch Leerzeichen getrennt):
BTN_DETECT=Erkennen
STATUS_DETECTING=Erkennung läuft...
LBL_DIRECTION=Richtung:
BTN_DISCONNECT=Trennen
LBL_ENDSTOP_LIMIT_SWITCH=Endschalter:
BTN_ERASE_FRAM=F-RAM löschen...
TAB_EXPANSION_BOARD=Erweiterungsplatine
LBL_EXPANSION_BOARD_TYPE=Typ der Erweiterungsplatine (siehe EXPANSION.TXT):
BTN_EXPORT_ASC=.asc exportieren...
BTN_EXPORT_TRC=.trc exportieren...
BTN_EXPORT_DEBUG_BUNDLE=Debug-Paket exportieren...
LBL_EXTRUDER_DIRECTION=Extruderrichtung:
HELP_EXTRUDER_MOTION_SHARED_FRAME=Die Extruderbewegung teilt sich denselben Frame mit dem Düsen-Sollwert (0x170), ist aber selbst nicht durch einen Watchdog überwacht - nur die Temperatur ist es.
LBL_EXTRUDER_STEPS=Extruderschritte:
TAB_FRAM=F-RAM
TAB_GLOBAL_CONTROLS=Globale Steuerungen
LBL_HEATER_ACTIVE_250MS=Heizung aktiv (250ms Watchdog)
LBL_HOTEND_FAN_RPM=Hotend-Lüfter-Drehzahl:
LBL_HOTEND_FAN_POWER=Hotend-Lüfterleistung (0-255):
LBL_HOTEND_TEMPERATURE=Hotend-Temperatur:
LBL_ID_PINS=ID-Pins:
LBL_IMPACTS_DETECTED_SESSION=In dieser Sitzung erkannte Treffer:
HELP_AOI_RING_IGNORED=Im AOI-Inspektionsmodus wird das Ein-/Ausschalten des Rings hier ignoriert - verwenden Sie stattdessen die eigene Ringmodus-Steuerung dieses Werkzeugs (0x150 deckt dort Ein/Aus/Blitz ab). Die Farbe gilt weiterhin.
LBL_INTERLOCK_ARMED=Verriegelung scharf (erforderlich, damit eine Leistung > 0 eine Wirkung hat)
HELP_INTERLOCK_MUST_BE_ARMED=Die Verriegelung muss unten explizit scharf geschaltet werden - dies ist ein echter Laser.
LBL_LAST_IMPACT=Letzter Treffer:
LBL_LAYER_FAN_RPM=Schichtlüfter-Drehzahl:
LBL_LAYER_FAN_POWER=Schichtlüfterleistung (0-255):
LBL_LIVE_TEMPERATURE=Live-Temperatur:
TITLE_LOG=Protokoll
BTN_MOVE_EXTRUDER_ONCE=Extruder einmal bewegen
BTN_MOVE=Bewegen
HELP_NO_WATCHDOG_STALL_DETECTOR=Kein Kommunikations-Watchdog an diesem Lüfter - er ist stattdessen durch einen Blockierdetektor geschützt (0 U/min 3s nach dem Start = kritischer Fehler), da der Verlust dieses Lüfters auch dann zählt, wenn der Master kurz still ist.
STATUS_NO_RESPONSE_CHECK_WIRING=Keine Antwort - Verkabelung/Stromversorgung/Bitrate prüfen
STATUS_NO_RESPONSE_ANY_BITRATE=Bei keiner Standard-Bitrate eine Antwort
STATUS_NO_RESPONSE_0X110=Keine Antwort auf 0x110 - ist die Firmware auf diesem Board aktuell genug, um dies zu unterstützen?
HELP_NO_WATCHDOG_HOLDS_VALUE=Kein Watchdog bei diesem Befehl - er bleibt bestehen, bis ein neuer Wert gesendet wird, 0 Geschwindigkeit aktiviert die aktive Bremse.
STATUS_NOT_CONNECTED=Nicht verbunden
LBL_NOZZLE_SETPOINT=Düsen-Sollwert (\u00b0C, 0-300):
LBL_OLED_MODE=OLED-Modus:
HELP_ONE_SHOT_NO_TELEMETRY=Einmalbefehl, keine Telemetrie von diesem Werkzeug - die Firmware aktiviert den Treiber beim Empfang dieses Frames und schaltet die Leistung ab, sobald die Bewegung abgeschlossen ist.
BTN_OPEN_BUS_MONITOR=Rohen Bus-Monitor öffnen...
LBL_PART_DETECTED_LM393=Teil erkannt (LM393):
BTN_PAUSE=Pause
LBL_PERSISTENCE_FRAM=Persistenz-F-RAM (FM24CL64B, teilt sich I2C2 mit dem OLED):
LBL_POWER_0_255=Leistung (0-255):
BTN_QUERY_DIAG0=DIAG0 abfragen
BTN_QUERY_STATE=Status abfragen
BTN_QUERY=Abfragen
HELP_READONLY_SET_VIA_FLASHER=Hier nur lesbar - wird über den CAN-OTA-Bereich von URTC Flasher festgelegt, da es sich um einen einmaligen Hardware-Konfigurationsschritt handelt, der zusammen mit einem Firmware-Update durchgeführt wird, nicht etwas, das von diesem Werkzeug aus geändert wird.
BTN_REFRESH=Aktualisieren
LBL_REPEAT_EVERY=Wiederholen alle
LBL_RESPONSE=Antwort:
LBL_RING_LED_RGB=Ring-LED (R/G/B):
HELP_RING_COLOR_FROM_GLOBAL=Die Ringfarbe stammt aus dem Bedienfeld Globale Steuerungen oben (0x100) - dies steuert nur das Ein-/Aus-/Blitz-Timing, nicht die Farbe selbst.
LBL_RING_MODE=Ringmodus:
CHK_RING_ON=Ring an
BTN_RUN_SELF_TEST=Selbsttest ausführen...
LBL_SPI_BYTES_TO_SEND=Zu sendende SPI-Bytes (hex, durch Leerzeichen getrennt):
TITLE_SCAN_PROBE_TELEMETRY=Scan-Sonde - nur Ereignistelemetrie (0x095)
BTN_SEND_ONCE=Einmal senden
BTN_SEND=Senden
HELP_SENDS_RAW_FRAME=Sendet einen rohen Frame - nützlich für einen Befehl, der hier noch keine eigene dedizierte Steuerung hat, oder um etwas zu testen, das (noch) nicht in CANBUS.TXT dokumentiert ist. Keine Validierung außer ID-Bereich und DLC\u22648 - was auch immer gesendet wird, ist genau das, was auf den Bus gelangt.
HELP_SCAN_PROBE_INTERRUPT=Direkt vom Berührungs-Interrupt auf der niedrigsten (höchste Priorität) CAN-ID des gesamten Busses gesendet, unter Umgehung jedes Schedulers - dies sollte konstruktionsbedingt bei jedem Kontakt praktisch sofort eintreffen.
RADIO_SERIAL_SLCAN=Seriell / SLCAN
LBL_SETPOINT_TEMPERATURE=Solltemperatur (\u00b0C, 0-450):
HELP_SHOWS_EVERY_FRAME=Zeigt jeden gesehenen Frame, egal welche ID - unabhängig vom aktiven Werkzeugfeld.
RADIO_SOCKETCAN_NATIVE=SocketCAN (nativ)
LBL_SPEED_0_255=Geschwindigkeit (0-255):
LBL_STATUS_LED_OVERRIDE=Status-LED-Übersteuerung (R/G/B):
LBL_STEPS=Schritte:
LBL_STROBE_PERIOD=Blitzperiode:
LBL_TOOL_NUMBER=Werkzeug #:
TAB_TOOL_CONTROLS=Werkzeugsteuerungen
LBL_TRANSPORT=Übertragung:
STATUS_TRYING_EACH_BITRATE=Jede Bitrate wird ausprobiert...
HELP_UP_TO_7_BYTES_SPI=Bis zu 7 Bytes pro Übertragung (CS während des gesamten Vorgangs niedrig gehalten) - entspricht dem, was ein einzelner 0x180-Frame transportieren kann (1 Längenbyte + bis zu 7 Datenbytes).
TITLE_VACUUM_TELEMETRY=Vakuumgreifer - nur Telemetrie (0x145)
LBL_MS_UNIT=ms
LBL_CAN_INTERFACE=CAN-Schnittstelle:
HELP_SOCKETCAN_BITRATE_OS_LEVEL=Die Bitrate von SocketCAN wird auf Betriebssystemebene festgelegt (ip link), nicht hier
COL_TIME=Zeit
COL_ID=ID
COL_DLC=DLC
COL_DATA_HEX=Daten (hex)
COL_DT_MS=Δt (ms)
TITLE_RESTART_NEEDED=Neustart erforderlich
MSG_RESTART_NEEDED=Starten Sie URTC Tester neu, damit die neue Sprache wirksam wird.
TITLE_COULDNT_SAVE=Speichern fehlgeschlagen
MSG_LANGUAGE_NOT_SAVED=Die Spracheinstellung wurde nicht gespeichert - prüfen Sie, ob {path} beschreibbar ist.
TITLE_NOT_CONNECTED=Nicht verbunden
MSG_CONNECT_FIRST=Zuerst mit dem Adapter verbinden.
TITLE_BAD_INPUT=Ungültige Eingabe
TITLE_EXPORT_FAILED=Export fehlgeschlagen
TITLE_NOTHING_SELECTED=Nichts ausgewählt
MSG_SELECT_PORT_FIRST=Zuerst einen Port/eine Schnittstelle auswählen.
TITLE_CONNECTION_FAILED=Verbindung fehlgeschlagen
TITLE_ALREADY_CONNECTED=Bereits verbunden
MSG_DISCONNECT_FIRST_AUTODETECT=Zuerst trennen, dann die automatische Erkennung vor dem erneuten Verbinden ausführen.
MSG_SELECT_COM_PORT_FIRST=Zuerst einen COM-Port auswählen.
TITLE_NOT_DETECTED=Nicht erkannt
MSG_RUN_DETECT_FIRST=Zuerst Erkennen ausführen, damit bekannt ist, welches Werkzeug getestet werden soll.
TITLE_NOTHING_TO_EXPORT=Nichts zu exportieren
MSG_TABLE_IS_EMPTY=Die Tabelle ist leer.
TITLE_NO_CONFIRMATION=Keine Bestätigung
MSG_ERASE_NO_RESPONSE=Löschbefehl gesendet, aber keine Bestätigung erhalten.
TITLE_ERASED=Gelöscht
MSG_FRAM_ERASED_CONFIRMED=F-RAM gelöscht und vom Board bestätigt.
TITLE_DEBUG_BUNDLE_SAVED=Debug-Paket gespeichert
MSG_SAVED_TO=Gespeichert unter:\n{path}
TITLE_CONNECTION_FAILED_PERMISSION=Verbindung fehlgeschlagen - Zugriff verweigert
MSG_PERMISSION_DENIED_HELP={msg}\n\nUnter Linux benötigen serielle Geräte in der Regel, dass Ihr Benutzer in der Gruppe 'dialout' ist:\n\n    sudo usermod -a -G dialout $USER\n\nMelden Sie sich dann ab und wieder an (Gruppenzugehörigkeit wird beim Anmelden gelesen) und versuchen Sie es erneut.
TITLE_PYSERIAL_NOT_INSTALLED=pyserial nicht installiert
MSG_PYSERIAL_NEEDED_AUTODETECT=Die automatische Erkennung benötigt pyserial für serielle/SLCAN-Verbindungen.\n\nInstallieren Sie es mit: pip install pyserial
TITLE_RUN_SELF_TEST_Q=Selbsttest ausführen?
MSG_SELF_TEST_CONFIRM=Dies sendet eine kleine Anzahl sicherer Befehle im Ruhezustand (Sollwert/Geschwindigkeit/Leistung alle auf 0), um zu prüfen, ob das Board wie für das erkannte Werkzeug erwartet reagiert - nichts hier heizt, feuert oder dreht irgendetwas mit nennenswerter Leistung. Fortfahren?
TITLE_ERASE_FRAM_Q=F-RAM löschen?
MSG_ERASE_FRAM_CONFIRM=Dies löscht dauerhaft den gespeicherten Parameterstatus im Persistenz-F-RAM des Boards. Dies kann nicht rückgängig gemacht werden. Fortfahren?
TITLE_PLAIN_STEPPER_MOTION={tool} - einfache Schrittmotorbewegung (0x120)
OPT_STANDARD=Standard
OPT_NIGHT=Nacht
OPT_STANDBY=Standby
OPT_FORWARD=Vorwärts
OPT_REVERSE=Rückwärts
OPT_CLOCKWISE=Im Uhrzeigersinn
OPT_COUNTER_CLOCKWISE=Gegen den Uhrzeigersinn
OPT_OFF=Aus
OPT_SYNCHRONOUS_STROBE=Synchroner Blitz
OPT_FIXED_CONTINUOUS=Fest kontinuierlich
OPT_RETRACT=Einziehen
WARN_NO_CARRIER=WARNUNG: {interface} meldet keinen Träger - dies zeigt der Kernel bei einem CAN-Bus-Off-Zustand (zu viele Übertragungsfehler) oder einer ähnlich toten Verbindung an. Wenn der Adapter mit Strom versorgt und an einen aktiven Bus angeschlossen ist, versuchen Sie: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=Busleseefehler: {e}
LOG_HANDLER_ERROR=Handlerfehler für 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=Sniffer-Callback-Fehler: {e}
LOG_TESTER_READY=URTC Tester bereit. Erwartete HardwareID: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Adapter im SLCAN-Modus erwartet - siehe README, wenn Ihr CANable als etwas anderes als ein serieller Port erscheint.
LOG_EXPECTING_SOCKETCAN_MODE=SocketCAN-Modus - es wird erwartet, dass die Schnittstelle bereits mit 500 kbit/s aktiv ist (ip link set ... up type can bitrate 500000). Siehe den Linux-Abschnitt des README.
LOG_CONNECTED_TO_PORT=Verbunden mit {port}, CAN-Kanal geöffnet
LOG_AT_BITRATE_SUFFIX= bei {bitrate}.
LOG_DISCONNECTED=Getrennt.
LOG_AUTODETECT_TRYING=Automatische Erkennung: {label} wird versucht...
LOG_AUTODETECT_RESPONDED=Automatische Erkennung: Board hat bei {label} geantwortet.
LOG_AUTODETECT_NO_RESPONSE=Automatische Erkennung: keine Antwort bei irgendeiner Standard-Bitrate - Verkabelung/Stromversorgung prüfen, oder das Board verwendet möglicherweise eine nicht standardmäßige Bitrate, die dies nicht ausprobieren kann.
LOG_QUERYING_ACTIVE_TOOL=Aktives Werkzeug wird abgefragt (0x110)...
LOG_QUERYING_VERSION=Version wird abgefragt (0x7F8)...
LOG_DETECT_FAILED=Erkennung fehlgeschlagen: {e} - die Verbindung wurde moeglicherweise waehrenddessen getrennt.
LOG_DETECTION_FAILED=Erkennung fehlgeschlagen: keine Antwort auf beide Abfragen.
LOG_ACTIVE_TOOL_STATE=Aktives Werkzeug: {name} (ID {tool_id}). Status: {state}.
LOG_NO_RESPONSE_0X110_HELP=Keine Antwort auf die Abfrage des aktiven Werkzeugs (0x110/0x111) - dies erfordert STM32F303CC.C, das mit dieser Unterstützung kompiliert wurde; ältere Firmware wird nicht darauf antworten.
LOG_VERSION_INFO=Version: {role}, HardwareID 0x{hw_id:08X}{hw_note}, Firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=Ausschaltbefehl 0x{cmd_id:03X} konnte beim Wechsel vom Werkzeug {tool_id} nicht gesendet werden: {e}
LOG_OFF_COMMAND_FAILED=Ausschaltbefehl konnte beim Wechsel vom Werkzeug {tool_id} nicht gesendet werden: {e}
LOG_SENT_GLOBAL_STATUS=Gesendet 0x100: Status-RGB=({r1},{g1},{b1}), Nacht={night}, Ring-RGB=({r2},{g2},{b2}), Ring_an={ring_on}
LOG_EXPORTED_FRAMES={n} Frames nach {path} exportiert
LOG_QUERIED_0X182_NO_RESPONSE=0x182 abgefragt - keine 0x183-Antwort.
LOG_EXP_TMC_DIAG0_LEVEL=TMC_DIAG0-Pegel: {level}
LBL_EMPTY_PARENS=(leer)
LOG_SENT_CUSTOM_FRAME=Benutzerdefinierter Frame gesendet: ID=0x{can_id:03X}, Daten={data}
LOG_REPEATING_CUSTOM_FRAME=Wiederholung des benutzerdefinierten Frames alle {interval}ms: ID=0x{can_id:03X}, Daten={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Benutzerdefinierter periodischer Frame: Zyklen werden übersprungen, bis das Feld wieder gültig ist ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Benutzerdefinierter periodischer Frame: Feld ist wieder gültig, Senden wird fortgesetzt.
MSG_ENTER_HEX_BYTES_EXAMPLE=Durch Leerzeichen getrennte Hex-Bytes eingeben, z. B. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Zwischen 1 und 7 Bytes eingeben.
LBL_SPI_NO_RESPONSE=(keine Antwort - Board führt diese Firmware-Version nicht aus oder ist nicht verbunden)
LOG_SENT_0X180_NO_RESPONSE=Gesendet 0x180 ({tx}) - keine 0x181-Antwort.
LBL_SPI_MALFORMED=(fehlerhaft: {n} Bytes angegeben, nur {actual} angekommen)
LOG_SENT_0X180_MALFORMED=Gesendet 0x180 ({tx}) - die 0x181-Antwort gab {n} Bytes an, aber es kamen nur {actual} tatsächlich an: {rx}
LOG_SENT_0X180_RECEIVED=Gesendet 0x180 ({tx}), zurück empfangen: {rx}
LOG_QUERIED_0X1A1_NO_RESPONSE=0x1A1 abgefragt - keine gültige Antwort.
LOG_EXPANSION_BOARD_TYPE=Typ der Erweiterungsplatine: {label}
LOG_QUERIED_0X190_NO_RESPONSE=0x190 abgefragt - keine 0x191-Antwort.
LOG_FRAM_STATE_NOTHING_SAVED=F-RAM-Status: nichts Gültiges gespeichert.
LOG_FRAM_STATE_FULL=F-RAM-Status: Werkzeug={tool}, Temp={temp}, Geschwindigkeit/Leistung={speed}, Richtung/Verriegelung={dir_or_interlock}, Lüfter={fan}, Fehler_aufgetreten={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=F-RAM-Löschung gesendet (0x192) - keine Bestätigungsantwort erhalten.
LOG_FRAM_ERASED_CONFIRMED=F-RAM gelöscht und bestätigt.
LOG_KEEPALIVE_STOPPED=Keepalive '{name}' gestoppt: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Lötkolben: Sollwert {temp}°C, Senden alle 150ms (Firmware-Watchdog ist 250ms).
LOG_SOLDER_TURNED_OFF=Lötkolben: ausgeschaltet (Sollwert 0 einmal gesendet).
LOG_TOOL_MOVE={tool}: Bewegung {direction}, {n} Schritte.
LOG_AOI_MODE_PERIOD=AOI: Modus={mode}, Periode={period}
LBL_ARMED=scharf
LBL_SAFE=sicher
LOG_LASER_POWER_INTERLOCK=Laser: Leistung {power}, Verriegelung {interlock}, Senden alle 150ms (Firmware-Watchdog ist 250ms).
LOG_LASER_STOPPED=Laser: gestoppt (Leistung 0, sichere Verriegelung einmal gesendet).
LOG_SCAN_PROBE_IMPACT=Scan-Sonde: Treffer erkannt um {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=3D-Drucker-Düse: Sollwert {temp}°C, Senden alle 150ms (Firmware-Watchdog ist 250ms, Extruderbewegung nicht durch Watchdog überwacht).
LOG_3DP_NOZZLE_TURNED_OFF=3D-Drucker-Düse: ausgeschaltet (Sollwert 0 einmal gesendet).
LOG_LAYER_FAN_ACTIVE=Schichtlüfter: Leistung {power}, Senden alle 400ms (Firmware-Watchdog ist 1000ms).
LOG_LAYER_FAN_STOPPED=Schichtlüfter: gestoppt (Leistung 0 einmal gesendet).
LOG_DEBUG_BUNDLE_EXPORTED=Debug-Paket exportiert nach {path}

