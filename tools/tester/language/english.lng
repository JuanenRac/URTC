OPT_FIXED_CONTINUOUS=Fixed continuous
OPT_RETRACT=Retract
WARN_NO_CARRIER=WARNING: {interface} reports no carrier - this is what the kernel shows during a CAN bus-off condition (too many transmit errors) or a similarly dead link. If the adapter is powered and wired to a live bus, try: sudo ip link set {interface} down && sudo ip link set {interface} up type can bitrate 500000 restart-ms 100
LOG_BUS_READ_ERROR=bus read error: {e}
LOG_HANDLER_ERROR=handler error for 0x{can_id:03X}: {e}
LOG_SNIFFER_ERROR=sniffer callback error: {e}
LOG_TESTER_READY=URTC Tester ready. Expected HardwareID: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Expecting the adapter in SLCAN mode - see the README if your CANable shows up as anything other than a serial port.
LOG_EXPECTING_SOCKETCAN_MODE=SocketCAN mode - expecting the interface already up at 500 kbit/s (ip link set ... up type can bitrate 500000). See the README's Linux section.
LOG_CONNECTED_TO_PORT=Connected to {port}, CAN channel open
LOG_AT_BITRATE_SUFFIX= at {bitrate}.
LOG_DISCONNECTED=Disconnected.
LOG_AUTODETECT_TRYING=Auto-detect: trying {label}...
LOG_AUTODETECT_RESPONDED=Auto-detect: board responded at {label}.
LOG_AUTODETECT_NO_RESPONSE=Auto-detect: no response at any standard bitrate - check wiring/power, or the board may be using a non-standard bitrate this can't try.
LOG_QUERYING_ACTIVE_TOOL=Querying active tool (0x110)...
LOG_QUERYING_VERSION=Querying version (0x7F8)...
LOG_DETECT_FAILED=Detection failed: {e} - the connection may have closed while this was in progress.
LOG_DETECTION_FAILED=Detection failed: no response to either query.
LOG_ACTIVE_TOOL_STATE=Active tool: {name} (ID {tool_id}). State: {state}.
LOG_NO_RESPONSE_0X110_HELP=No response to the active-tool query (0x110/0x111) - this needs STM32F303CC.C built with that support; older firmware won't answer it.
LOG_VERSION_INFO=Version: {role}, HardwareID 0x{hw_id:08X}{hw_note}, firmware v{major}.{minor}
LOG_OFF_COMMAND_FAILED_ID=Couldn't send off-command 0x{cmd_id:03X} while switching away from tool {tool_id}: {e}
LOG_OFF_COMMAND_FAILED=Couldn't send off-command while switching away from tool {tool_id}: {e}
LOG_SENT_GLOBAL_STATUS=Sent 0x100: status RGB=({r1},{g1},{b1}), night={night}, ring RGB=({r2},{g2},{b2}), ring_on={ring_on}
LOG_EXPORTED_FRAMES=Exported {n} frames to {path}
LOG_QUERIED_0X182_NO_RESPONSE=Queried 0x182 - no 0x183 response.
LOG_EXP_TMC_DIAG0_LEVEL=TMC_DIAG0 level: {level}
LBL_EMPTY_PARENS=(empty)
LOG_SENT_CUSTOM_FRAME=Sent custom frame: ID=0x{can_id:03X}, data={data}
LOG_REPEATING_CUSTOM_FRAME=Repeating custom frame every {interval}ms: ID=0x{can_id:03X}, data={data}
LOG_CUSTOM_PERIODIC_SKIPPING=Custom periodic frame: skipping ticks until the field is valid again ({e})
LOG_CUSTOM_PERIODIC_RESUMING=Custom periodic frame: field is valid again, resuming sends.
MSG_ENTER_HEX_BYTES_EXAMPLE=Enter space-separated hex bytes, e.g. 01 02 03
MSG_ENTER_1_TO_7_BYTES=Enter between 1 and 7 bytes.
LBL_SPI_NO_RESPONSE=(no response - board not running this firmware version, or not connected)
LOG_SENT_0X180_NO_RESPONSE=Sent 0x180 ({tx}) - no 0x181 response.
LBL_SPI_MALFORMED=(malformed: declared {n} bytes, only {actual} arrived)
LOG_SENT_0X180_MALFORMED=Sent 0x180 ({tx}) - 0x181 response declared {n} bytes but only {actual} actually arrived: {rx}
LOG_SENT_0X180_RECEIVED=Sent 0x180 ({tx}), received back: {rx}
LOG_QUERIED_0X1A1_NO_RESPONSE=Queried 0x1A1 - no valid response.
LOG_EXPANSION_BOARD_TYPE=Expansion board type: {label}
LOG_QUERIED_0X190_NO_RESPONSE=Queried 0x190 - no 0x191 response.
LOG_FRAM_STATE_NOTHING_SAVED=F-RAM state: nothing valid saved.
LOG_FRAM_STATE_FULL=F-RAM state: tool={tool}, temp={temp}, speed/power={speed}, dir/interlock={dir_or_interlock}, fan={fan}, had_error={had_error}
LOG_FRAM_ERASE_NO_CONFIRM=Sent F-RAM erase (0x192) - no confirmation response received.
LOG_FRAM_ERASED_CONFIRMED=F-RAM erased and confirmed.
LOG_KEEPALIVE_STOPPED=Keepalive '{name}' stopped: {e}
LOG_SOLDER_SETPOINT_ACTIVE=Soldering iron: setpoint {temp}°C, sending every 150ms (firmware watchdog is 250ms).
LOG_SOLDER_TURNED_OFF=Soldering iron: turned off (setpoint 0 sent once).
LOG_TOOL_MOVE={tool}: move {direction}, {n} steps.
LOG_AOI_MODE_PERIOD=AOI: mode={mode}, period={period}
LBL_ARMED=armed
LBL_SAFE=safe
LOG_LASER_POWER_INTERLOCK=Laser: power {power}, interlock {interlock}, sending every 150ms (firmware watchdog is 250ms).
LOG_LASER_STOPPED=Laser: stopped (power 0, interlock safe sent once).
LOG_SCAN_PROBE_IMPACT=Scan probe: impact detected at {ts}
LOG_3DP_NOZZLE_SETPOINT_ACTIVE=3D printer nozzle: setpoint {temp}°C, sending every 150ms (firmware watchdog is 250ms, extruder motion not watchdog-guarded).
LOG_3DP_NOZZLE_TURNED_OFF=3D printer nozzle: turned off (setpoint 0 sent once).
LOG_LAYER_FAN_ACTIVE=Layer fan: power {power}, sending every 400ms (firmware watchdog is 1000ms).
LOG_LAYER_FAN_STOPPED=Layer fan: stopped (power 0 sent once).
LOG_DEBUG_BUNDLE_EXPORTED=Debug bundle exported to {path}

