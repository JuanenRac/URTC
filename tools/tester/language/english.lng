# URTC Tester - English language file
# KEY=Value, one per line. Lines starting with # and blank lines are
# ignored. A literal \n inside a value becomes a real line break.

STATUS_CONNECT_TO_CHECK=(connect to check)
STATUS_CONNECT_TO_DETECT=(connect to detect)
STATUS_NO_RESPONSE_SHORT=(no response)
LBL_ACTIVE_1000MS_WATCHDOG=Active (1000ms watchdog)
