build/
# HYDRA-UMC shared secret protection
.env
.env.*
!.env.example

# Python bytecode (generated locally; never source)
__pycache__/
*.py[cod]

# Firmware signing keys (docs/FIRMWARE_SIGNING.TXT) - never commit them
signing_keys*.txt
*.signing.key
*.key

# Firmware images are published only as assets of the GitHub release of their
# version (tools/publish_release_assets.py); build_firmware.sh writes them here.
firmware/*.bin
firmware/*.elf
firmware/*.hex
firmware/*.sha256
firmware/*.manifest.json
firmware/firmware_manifest.json
firmware/*.sig

# Output folders named after a Windows path (a path handed to WSL without translation): never versioned
C:/
C\uf03a/
Users/
.coverage
