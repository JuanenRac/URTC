# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Built firmware images are binary: no line-ending conversion, or their digests would change.
*.bin binary
*.elf binary
*.hex -text
